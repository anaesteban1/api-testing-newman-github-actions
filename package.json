{
  "name": "api-gestion-tareas-academicas",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de gestión de tareas académicas con pruebas Newman y CI en GitHub Actions",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:newman": "newman run postman/gestion-tareas.postman_collection.json --reporters cli,json --reporter-json-export reports/newman.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "newman": "^6.2.3"
  }
}
